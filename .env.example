# ==============================================================================
# SkillGraph - Environment Variables Template (.env.example)
# ==============================================================================

# CognoDB Graph Database Connection (Bolt Protocol)
# Example: bolt+s://your-subdomain.bravo.databases.cognodb.com or bolt://localhost:7687
COGNODB_URI=bolt://localhost:7687
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_secure_password_here

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Frontend Vite Configuration
VITE_API_URL=http://localhost:5000/api
